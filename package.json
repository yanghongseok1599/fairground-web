{
  "name": "fairground-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/prepare-face-landmarker.mjs",
    "predev": "node scripts/supabase/check-safety.mjs dev",
    "dev": "next dev",
    "prebuild": "node scripts/supabase/check-schema-parity.mjs",
    "build": "next build && next-sitemap",
    "start": "next start",
    "lint": "eslint",
    "security:audit": "npm audit --audit-level=moderate",
    "supabase:safety": "node scripts/supabase/check-safety.mjs status",
    "supabase:parity": "node scripts/supabase/check-schema-parity.mjs",
    "supabase:migrations": "npx supabase migration list --linked",
    "test:supabase-safety": "node --test tests/supabase-safety.test.mjs",
    "test:schema-parity": "node --test tests/schema-parity.test.mjs",
    "test:security": "node --experimental-strip-types tests/security-hardening.test.ts",
    "test:player-card": "node --experimental-strip-types tests/player-card-frame.test.ts && node --experimental-strip-types tests/player-card-photo-fallback.test.ts && node --experimental-strip-types tests/player-card-assets.test.ts && node --experimental-strip-types tests/player-card-face-geometry.test.ts",
    "test:photo-read": "node --test tests/player-card-photo-read.test.mjs"
  },
  "dependencies": {
    "@imgly/background-removal": "^1.7.0",
    "@mediapipe/tasks-vision": "0.10.32",
    "@supabase/supabase-js": "^2.105.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.34.1",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.564.0",
    "next": "16.3.3",
    "next-sitemap": "^4.2.3",
    "ogl": "^1.0.11",
    "onnxruntime-web": "^1.21.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.4.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "pg": "^8.23.0",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.26",
    "protobufjs": "7.6.6",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    }
  }
}
